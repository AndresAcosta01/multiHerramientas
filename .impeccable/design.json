  "narrative": {
    "northStar": "The Ruled Ledger",
    "overview": "A pale blue-white ground divided by 1px rules into a T-frame, with near-black type and one muted steel-blue accent used only on tiny marks (focus ring, active nav icon, text links, caret). Everything structural is monochrome. Colour is reserved for data: each payroll concept owns one hue (fifteen pairs; the three deductions share one), and the second tool adds six more pairs for coverage status and break types, all shown as a pale tint and a deep tone. The screen is quiet so the numbers and their colours are the only things that speak.\n\nThe build is an operate surface: dense but unhurried, 14px body, tabular figures everywhere a number can change, controls 32-40px tall. Cards are white on the tinted ground with a 1px border and no shadow. Motion is feedback only.",
    "keyCharacteristics": [
      "Ruled T-frame: 232px sidebar and 64px top bar share the ground and are separated only by 1px rules.",
      "Colour lives only on data; chrome is neutral.",
      "One signature: the colour-composition bar, echoed by the legend chips and the table-row highlight.",
      "Figtree Variable with tabular numerals.",
      "Flat at rest; shadow only on elements that float (toast, dialog)."
    ],
    "rules": [
      {
        "name": "The Colour-On-Data Rule",
        "body": "Chroma appears only where it names a concept. Chrome, headings, buttons and borders stay neutral.",
        "section": "colors"
      },
      {
        "name": "The Small Accent Rule",
        "body": "The steel accent is never a fill or a surface; it marks focus, the active item and links.",
        "section": "colors"
      },
      {
        "name": "The Pair Rule",
        "body": "A concept is always shown with its tint for areas and its deep tone for bars and borders; never the reverse.",
        "section": "colors"
      },
      {
        "name": "The Size Scale",
        "body": "Sizes in use are 12, 13, 14, 15, 16, 18, 20 and 32px; nothing else for new work. The 11px / 600 numbers in the \"Fuera\" cells are an outlier the build carries, not part of the scale. 24px is a spacing value (gap, padding), not a type size.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any figure that can change (money, hours, percentages, counts) uses font-variant-numeric: tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Labels are sentence case at normal tracking; no uppercase micro-labels.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Floating Rule",
        "body": "A surface gets a shadow only if it overlays other content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do colour only data: pair each concept's -c tint with its -d tone.",
      "Do separate regions with 1px border or rule lines, not fills or shadows.",
      "Do use tabular numerals for every changing figure.",
      "Do use 6px for controls, 8px for cards, 12px for dialogs and the sheet top; 4px only for inner buttons and text buttons.",
      "Do give every pressable a scale(0.97) press and a visible 2px accent focus ring.",
      "Do keep the accent to marks (focus, active icon, links)."
    ],
    "donts": [
      "Don't fill chrome (headers, nav, buttons other than the Ink Navy primary) with concept hues or the accent.",
      "Don't add shadows to in-flow cards; reserve them for toast and dialog.",
      "Don't animate layout for decoration; motion confirms an action.",
      "Don't introduce a second typeface or uppercase eyebrow labels above headings.",
      "Don't hardcode a new data colour outside the twenty-one pairs; add a pair to the tokens instead."
    ]
  }
}